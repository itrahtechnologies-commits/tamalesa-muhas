# .env.example — Nakili file hii kuwa .env.local na ujaze maadili halisi

# ── AI (Gemini) ──────────────────────────────────────────────────────────────
# Inahitajika kwa AI features
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ── App URL ──────────────────────────────────────────────────────────────────
# Kwa maendeleo ya ndani
APP_URL="http://localhost:3000"
# Kwa Vercel (badilisha na URL yako ya kweli)
# APP_URL="https://tamelasa.vercel.app"

# ── Database: Supabase (Inashauriwa kwa Vercel) ───────────────────────────────
# Ikiwa hujasanidi Supabase, mfumo utatumia kumbukumbu ya ndani (ephemeral).
# Data itapotea wakati serverless function inaanza upya.
#
# Jinsi ya kupata maadili haya:
#   1. Nenda https://supabase.com → Dashboard → Settings → API
#   2. Nakili "Project URL" na "anon/public" key
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# ── Payment Gateway (Hiari) ───────────────────────────────────────────────────
# Ikiwa unatumia gateway ya nje (Selcom, Pesapal, DPO, Flutterwave):
# PAYMENT_GATEWAY_URL="https://checkout.selcom.net"
VITE_PAYMENT_API_URL=""
PAYMENT_GATEWAY_URL=""
