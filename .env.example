# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Persistent Backend Database is automatically stored in server/data/tamelasa_db.json
# No configuration required for the built-in database.

# Payment Gateway Configuration:
# By default, the system includes a built-in hosted payment gateway checkout portal at /pay/:orderId
# If using an external gateway provider (Selcom, Pesapal, DPO Group, or Flutterwave), specify its base URL:
# Examples:
# PAYMENT_GATEWAY_URL="https://checkout.selcom.net"
# PAYMENT_GATEWAY_URL="https://pay.pesapal.com"
# PAYMENT_GATEWAY_URL="https://secure.3gdirectpay.com"
VITE_PAYMENT_API_URL=""
PAYMENT_GATEWAY_URL=""

# Supabase optional settings (if using remote Supabase PostgreSQL instead of built-in local database):
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
